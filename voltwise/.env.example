# Full backend API URL the app connects to — include scheme, host, port, and /api.
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app at runtime.
#   • Emulator / web:    http://localhost:3000/api
#   • Physical device:   http://<your-dev-machine-LAN-IP>:3000/api  (e.g. 192.168.1.10)
EXPO_PUBLIC_BASE_URL=http://localhost:3000/api

# MQTT
TLS_MQTT_BROKER_URL=localhost:8080
