# Full backend API URL the app connects to — include scheme, host, port, and /api.
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app at runtime.
#   • Emulator / web:    http://localhost:3000/api
#   • Physical device:   http://<your-dev-machine-LAN-IP>:3000/api  (e.g. 192.168.1.10)
EXPO_PUBLIC_BASE_URL=http://localhost:3000/api

# MQTT over secure WebSocket (HiveMQ Cloud uses port 8884 + /mqtt path for WSS).
# These ship inside the JS bundle — prefer a subscribe-only HiveMQ credential.
# Real values go in the untracked .env; restart with `npx expo start --clear`.
EXPO_PUBLIC_MQTT_URL=wss://e8438b0ef58c44b9886ce895ef33de3d.s1.eu.hivemq.cloud:8884/mqtt
EXPO_PUBLIC_MQTT_USERNAME=your_hivemq_username
EXPO_PUBLIC_MQTT_PASSWORD=your_hivemq_password
# Must match DEVICE_UID in iot-voltwise/include/secrets.h
EXPO_PUBLIC_MQTT_DEVICE_UID=esp32-01
