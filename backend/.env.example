# Database PostgreSQL

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_USER=postgres
DATABASE_PASSWORD=Danny12345

DATABASE_URL="postgresql://postgres:Danny12345@localhost:5432/your_database_name"


# Database Production Supabase
DATABASE_URL="postgresql://your_database_user:your_database_password@your_supabase_url:5432/your_database_name"

# JWT Secret Key
JWT_SECRET_KEY=your_jwt_secret_key

# Server Port
PORT=3000

# MQTT (HiveMQ Cloud) — real credentials go only in the untracked .env
MQTT_HOST=e8438b0ef58c44b9886ce895ef33de3d.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password
# Must match DEVICE_UID in iot-voltwise/include/secrets.h
MQTT_DEVICE_UID=esp32-01
# Account that owns ingested sensor readings (must exist; seed creates it)
MQTT_INGEST_USER_EMAIL=demo@voltwise.app
# Optional: minimum ms between EnergyReading inserts (0 = store every message)
MQTT_INGEST_MIN_INTERVAL_MS=0

# New-load detection (suggests adding a device when whole-home watts step up).
# Set LOAD_DETECT_ENABLED=false to turn it off in noisy environments.
LOAD_DETECT_ENABLED=true
# Minimum sustained watts jump above the rolling baseline that counts as a new load
LOAD_DETECT_DELTA_WATTS=60
# Consecutive elevated telemetry samples (~2 s apart) required before firing
LOAD_DETECT_SUSTAIN_SAMPLES=3
# Minimum ms between two new-load alerts
LOAD_DETECT_COOLDOWN_MS=120000
