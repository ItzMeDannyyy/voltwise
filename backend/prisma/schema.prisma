generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DeviceStatus {
  ACTIVE
  IDLE
  OFF
}

enum AlertType {
  CRITICAL
  WARNING
  INFO
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  firstName    String?
  lastName     String?
  passwordHash String?
  currency     String   @default("₱")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // When the password was last replaced. Null for accounts that have never
  // changed it since registering — the Privacy & Security screen falls back to
  // createdAt in that case.
  passwordChangedAt DateTime?

  rooms          Room[]
  devices        Device[]
  alerts         Alert[]
  tariffs        Tariff[]
  billingPeriods BillingPeriod[]
  energyReadings EnergyReading[]
  sessions       Session[]
}

// One row per sign-in. The session id travels in the JWT as `sid`, and
// requireAuth refuses a token whose session is missing, revoked or expired —
// that is what makes "sign out this device" and "sign out everywhere else" real
// rather than a client-side gesture. Rows are kept after revocation so the
// Privacy & Security screen can still explain what happened to a session.
model Session {
  id         String    @id @default(uuid())
  userId     Int
  // Human-readable device label ("Pixel 7", "Chrome on Windows"). Supplied by
  // the client at sign-in; derived from the User-Agent when it isn't.
  label      String
  // "android" | "ios" | "web" | "unknown".
  platform   String    @default("unknown")
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  // Mirrors the JWT's own expiry so an abandoned session stops being listed
  // even though nobody ever revoked it.
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

model Tariff {
  id            Int      @id @default(autoincrement())
  userId        Int
  ratePerKwh    Float
  currency      String   @default("₱")
  effectiveFrom DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingPeriod {
  id             Int       @id @default(autoincrement())
  userId         Int
  startDate      DateTime
  endDate        DateTime?
  accumulatedKwh Float     @default(0)
  estimatedCost  Float     @default(0)
  tariffRate     Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id     Int    @id @default(autoincrement())
  userId Int
  name   String

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]
}

model Device {
  id         Int          @id @default(autoincrement())
  userId     Int
  roomId     Int?
  name       String
  category   String?
  imageUri   String?
  ratedWatts Int          @default(0)
  status     DeviceStatus
  enabled    Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  readings EnergyReading[]
  alerts   Alert[]
}

model EnergyReading {
  id        Int      @id @default(autoincrement())
  deviceId  Int?
  userId    Int
  timestamp DateTime
  watts       Float
  kwh         Float
  voltage     Float?
  current     Float?   // Amperage (A)
  frequency   Float?   // Hz
  powerFactor Float?   // PF, 0-1

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
  @@index([userId, timestamp])
}

model Alert {
  id             Int       @id @default(autoincrement())
  userId         Int
  deviceId       Int?
  type           AlertType
  title          String
  description    String
  recommendation String?
  threshold      Float?
  value          Float?
  read           Boolean   @default(false)
  createdAt      DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
}
